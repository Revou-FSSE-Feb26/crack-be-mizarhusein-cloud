DATABASE_URL="postgresql://saluna:saluna@localhost:5432/saluna_db?schema=public"
# Only needed when DATABASE_URL points at a pooled connection (e.g. Supabase's pgbouncer pooler) —
# Prisma uses DIRECT_URL for migrations instead, since migrations need a non-pooled connection.
DIRECT_URL="postgresql://saluna:saluna@localhost:5432/saluna_db?schema=public"
PORT=4000
